{
  "name": "social-wars-legacy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter content build",
    "build:content": "pnpm --filter content build",
    "check:content": "pnpm --filter content check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "test:integration": "node --test packages/server/src/pgstore.test.ts packages/server/src/socialstore.test.ts packages/server/src/schema.test.ts packages/server/src/migrations.test.ts packages/server/src/backup.test.ts packages/server/src/security.test.ts",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "verify:provenance": "node scripts/verify-provenance.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@swl/client": "workspace:*",
    "@swl/protocol": "workspace:*",
    "@swl/rules": "workspace:*",
    "@swl/server": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
