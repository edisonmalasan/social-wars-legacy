; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Social Wars boot client (M5 foundation).
; Pinned engine: Godot 4.7.2.stable.official.ed1daf0bf.
; Entry point is the boot scene; the GameApi autoload owns every server
; interaction (fake by default, loopback legacy_v0 for verification), the
; ContentRegistry autoload loads the canonical normalized content and
; the asset ID registry on explicit request only, the Session autoload
; holds the active session committed by a successful boot, the
; GameClock autoload holds the server-anchored game time committed by
; the same boot, the Settings autoload holds the two committed user
; preferences with explicit fail-closed persistence, and the
; AudioManager autoload owns the Music/SFX output buses and applies
; those preferences as bus mute.
; The render-verification scene stays runnable as its own scene. The
; camera controls and the UI foundation are non-autoload components
; instanced by scenes (OpenSpec `godot-camera`, `godot-ui-foundation`);
; Settings and AudioManager are the cross-cutting autoloads (OpenSpec
; `godot-settings-audio`).
; See README.md.

config_version=5

[application]

config/name="Social Wars First Render"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameApi="*res://scripts/gameapi/game_api.gd"
ContentRegistry="*res://scripts/content_registry.gd"
Session="*res://scripts/session.gd"
GameClock="*res://scripts/game_clock.gd"
Settings="*res://scripts/settings.gd"
AudioManager="*res://scripts/audio_manager.gd"

[audio]

driver="Dummy"

[display]

window/size/viewport_width=448
window/size/viewport_height=224
window/size/resizable=false
window/stretch/mode="disabled"

[gameapi]

; Implementation switch (spec: "GameApi abstraction"): "fake" keeps tests
; hermetic; verify-boot.ps1 selects "legacy_v0" explicitly at runtime via
; the --gameapi= user argument. The endpoint is loopback-only by contract.
implementation="fake"
endpoint="http://127.0.0.1:5056"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
