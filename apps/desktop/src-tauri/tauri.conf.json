{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Social Wars Legacy",
  "version": "0.1.0",
  "identifier": "org.socialwars.legacy",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Social Wars Legacy",
        "width": 760,
        "height": 600,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": ["icons/icon.png"],
    "resources": ["server/**/*"],
    "copyright": "See docs/LICENSING.md",
    "shortDescription": "A preservation of the 2012 game Social Wars."
  }
}
